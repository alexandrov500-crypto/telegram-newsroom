# Deterministic non-secret placeholders for GitHub Actions / local CI scripts.
# Copy or `set -a; source .github/ci-minimal.env; set +a` from repo root (paths are relative to cwd).
# Do NOT use these values in production.

OPENAI_API_KEY=sk-ci-placeholder-not-for-production
OPENAI_MODEL=gpt-4.1-mini
BOT_TOKEN=123456:ABCDEFCI-placeholder-token
TELETHON_SESSION_STRING=ci-test-session-placeholder
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=testhashci
ADMIN_USER_ID=1
TARGET_CHANNEL_ID=-1001234567890
SOURCE_CHANNELS=@testchannel
DATABASE_URL=sqlite+aiosqlite:///ci-artifacts/newsroom_ci.sqlite
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
RUNTIME_STATE_DIR=ci-artifacts/runtime-live
NEWSROOM_PROFILE=development
DRY_RUN=true
PIPELINE_INTERVAL_MINUTES=30
COLLECT_MESSAGES_PER_CHANNEL=40
MIN_RAW_POSTS_FOR_AI=3
LOG_LEVEL=INFO

# CI-only: baseline bundles omit soak-written timeline growth; skip this volatile metric in regression.
NEWSROOM_REGRESSION_SKIP_METRICS=timeline_bytes
# CI-only: bounded_state_report timeline_events grows during soak; skip for self-baseline qualification.
NEWSROOM_QUALIFICATION_SKIP_RUNTIME_KEYS=timeline_events,timeline_file_bytes
