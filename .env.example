# Minimal production template — full Timeweb VPS pack: deploy/timeweb/.env.example

ENV=production
APP_ENV=production
LOG_LEVEL=INFO

OPENAI_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=

APP_DEPLOYMENT_PROFILE=production-lite
NEWSROOM_PROFILE=production-lite

# Multi-lane ingestion (Reuters-style fast lane)
FAST_LANE_ENABLED=false
BREAKING_ONLY_MODE=false
BREAKING_OVERRIDE=false

# Single-runtime guarantee (set true only for local pytest / multi-instance dev)
# RUNTIME_SINGLETON_DISABLED=false
# Flock locks by bot token under ~/.newsroom/locks/ (stops two local processes; VPS+Mac still need one instance)
# NEWSROOM_LOCK_BY_BOT_TOKEN=true
# On Mac while VPS runs: SEND_STARTUP_NOTIFICATION=false
# Mac control plane (no polling): RUNTIME_NODE_ROLE=control TELEGRAM_POLLING_ENABLED=false
# VPS worker: RUNTIME_NODE_ROLE=worker (deploy/timeweb/.env.example)
# Remote status from Mac: NEWSROOM_WORKER_URL=http://YOUR_VPS:8080

# Event ledger replay (no Telegram; replays INGESTED events through router)
REPLAY_MODE=false
REPLAY_BATCH_LIMIT=50

# OPS control plane (runtime, no restart for API toggles)
OPS_INGESTION_ENABLED=true
OPS_SLOW_MODE=false
OPS_EMERGENCY_HALT=false
OPS_AUTO_CONTROLLER=true
OPS_MAX_QUEUE_DEPTH=256
OPS_PUBLISH_RATE_LIMIT_PER_MIN=12
OPS_AUTO_SLOW_DEPTH=64
OPS_AUTO_CRITICAL_DEPTH=128
OPS_AUTO_FAST_ONLY_DEPTH=96

# Autonomous app.main (local): bash scripts/run_local_newsroom.sh  OR  make run-local
# PIPELINE_INTERVAL_MINUTES=15
# PIPELINE_BOOTSTRAP_ON_START=true
# SEND_STARTUP_NOTIFICATION=false
# COLLECTOR_MEDIA_ENABLED=true

# Draft text: one-line bullet max length; single-source posts use full blurb (see draft_builder)
EDITORIAL_ONE_LINE_MAX=480
# Download photo/video from source Telegram posts (cache under RUNTIME_STATE_DIR/media_cache)
COLLECTOR_MEDIA_ENABLED=true
LANE_QUEUE_BREAKING_MAX=32
LANE_QUEUE_HIGH_MAX=128
LANE_QUEUE_NORMAL_MAX=512

# Editorial desk (quality gate before draft generation)
# DESK_MIN_QUALITY_SCORE=45
# DESK_LOWER_PRIORITY_SCORE=32
# DESK_MIN_MACRO_MARKET_SCORE=30
# DESK_RELEVANCE_FLOOR=0.28
# Publish starvation recovery (lowers threshold gradually; hard rejects unchanged)
# DESK_STARVATION_HOURS=6
# DESK_STARVATION_MAX_SCORE_REDUCTION=8
# DESK_STARVATION_MIN_SCORE_FLOOR=38
# DESK_STARVATION_RELEVANCE_FLOOR=0.22
# Category-aware desk floors (never below starvation effective cap)
# DESK_CATEGORY_MARKET_MIN=40
# DESK_CATEGORY_MACRO_MIN=38
# DESK_CATEGORY_BREAKING_MIN=48
# DESK_CATEGORY_ANALYSIS_MIN=36

# Final staging /health alerts
# STAGING_ZERO_DRAFT_TICKS=3
# STAGING_PUBLISH_FAILURES_1H_WARN=5
# STAGING_TICK_LOOKBACK=5

# Publish retry (failed_drafts table)
# FAILED_DRAFT_MAX_RETRIES=5

# Public channel render (clean posts; no debug metadata on channel)
# PUBLIC_HEADLINE_MAX_CHARS=140
# PUBLIC_BODY_MAX_CHARS=2800
# PUBLIC_WHY_IT_MATTERS=true
# PUBLIC_SOURCE_ATTRIBUTION_STYLE=source
# (alternative footer: PUBLIC_SOURCE_ATTRIBUTION_STYLE=via)

# Newsroom product (signal-first ranking, auto vs manual publish)
# NEWSROOM_PRIMARY_NICHES=macro,business,tech,ai,finance,geopolitics
# NEWSROOM_MIN_SIGNAL_SCORE=0.42
# NEWSROOM_MIN_TRUST_SCORE=0.55
# NEWSROOM_AUTO_PUBLISH_SIGNAL_MIN=0.72
# NEWSROOM_PUBLISH_SLA_MS=300000
# NEWSROOM_TIER2_CHANNELS=@cb_economics,@vedomosti

# Public launch preparation (Phases 1–10)
# PUBLIC_CONTENT_SANITIZER_STRICT=true
# EDITORIAL_TUNING_PATH=config/editorial_tuning.yaml
# PUBLISH_QUALITY_GATE_STRICT=false
# NEWSROOM_TRUST_MODE=high
# FINAL_STAGING_MODE=true
# FINAL_STAGING_MAX_PUBLISHES_PER_HOUR=6

# Pre-production validation — Telegram reliability (Phase 1)
# PRE_PRODUCTION_VALIDATION_MODE=true
# TELETHON_CONNECT_TIMEOUT_SEC=25
# COLLECT_CYCLE_TIMEOUT_SEC=300
# COLLECT_CYCLE_STALL_WARN_SEC=120

# Pre-public QA (mirror publishes to MODERATION_CHAT_ID, extra reports)
# PREPUBLIC_QA_MODE=false

# Controlled public rollout (staged limits — advisory/stricter, no gate bypass)
# Controlled public rollout (limits auto-publish by stage)
# CONTROLLED_PUBLIC_ROLLOUT=false
# ROLLOUT_STAGE=STAGE_0_PRIVATE_QA
# STAGE_1_LIMITED_PUBLIC | STAGE_2_OBSERVED_PUBLIC | STAGE_3_FULL_AUTONOMOUS
# FINAL_RELEASE_MIN_CONTINUITY=55
# Values: STAGE_0_PRIVATE_QA | STAGE_1_LIMITED_PUBLIC | STAGE_2_OBSERVED_PUBLIC | STAGE_3_FULL_AUTONOMOUS

# Publish continuity alerts (hours)
# ALERT_PUBLISH_GAP_HOURS=8
# PUBLIC_GO_MIN_CONTINUITY_SCORE=55

# Final public launch operations
# LIVE_ROLLBACK_MODE=false
# ASSERT_ACTIVATE_ROLLBACK_ON_FAIL=true
# ASSERT_MAX_STALE_TICKS=0
# ASSERT_MAX_RECOVERY_LOOPS=6
# ASSERT_MAX_SCHEDULER_STALE_SEC=3600
# POST_QUALITY_MIN_CHARS=80
# POST_QUALITY_TOPIC_BURST_THRESHOLD=4
# POST_QUALITY_REJECT_SPIKE_THRESHOLD=4
# FINAL_RELEASE_MAX_TELEGRAM_FAILURES=5

# Stability / operator control (see docs/FEATURE_FREEZE.md)
# GLOBAL_PUBLISH_PAUSE=false
# RUNTIME_CONTROL_MODE=normal
# Values: normal | soft_degraded | hard_degraded | text_only | paused

# Burn-in output recovery (staging — relax governance without breaking terminal contract)
# BURNIN_SOFT_GOVERNANCE=true
# BURNIN_OPENAI_ALWAYS_FALLBACK=true
# SOURCE_COOLDOWN_MINUTES=3
# CLUSTER_SUPPRESS_STRICT=false
# DUPLICATE_STRICT_MODE=false
# MIN_DRAFTS_PER_24H_TARGET=1
# MAX_TICK_RUNTIME_SEC=1200

# Autonomous draft media (source → OG → AI optional → branded fallback)
# MEDIA_PIPELINE_ENABLED=true
# MEDIA_AI_IMAGE_ENABLED=false
# MEDIA_DOWNLOAD_TIMEOUT_SEC=8

# Local vs VPS (set vps after migrating burn-in to server)
# NEWSROOM_RUNTIME_PROFILE=vps
# LOCAL_RUNTIME_ALLOWED=false
# VPS_HOST=
# VPS_USER=ubuntu

# Autonomous operations (off by default in staging)
# AUTO_PUBLISH_ENABLED=false
# AUTO_APPROVE_DRAFTS=false
# AUTO_PUBLISH_MIN_CONFIDENCE=0.72
# BACKUP_ON_STARTUP=true
# PIPELINE_TICK_STUCK_SEC=1200

# Pre-launch hardening (MANDATORY for 7-day burn-in before public launch)
# SOFT_LAUNCH_MODE=true
# SOFT_LAUNCH_MAX_PUBLISHES_PER_HOUR=8
# PIPELINE_STAGE_STUCK_SEC=900
# Validate: python3 tools/final_staging_validator.py --strict
# PUBLIC_SUMMARY_MAX_LINES=6
# PUBLIC_READABILITY_MIN=0.35

# Staging: mock Telegram sends (returns synthetic message_id; no channel API)
# STAGING_MOCK_TELEGRAM_PUBLISH=false

# Forensic: log stack + fail-closed on forbidden media kwargs (disable_web_page_preview on send_video)
# TELEGRAM_MEDIA_FORENSIC=true

# Incident recovery (DEBUG ONLY — disable after end-to-end flow confirmed)
# FORCE_AI_PIPELINE_ENABLED=true   # ignore circuit/degraded; UPSTREAM_PIPELINE_STATE=forced
# MINIMAL_PIPELINE_MODE=true       # alias: MINIMAL_NEWSROOM_MODE; bypass desk/governance/ranking
# FORCE_PUBLISH_BYPASS=true        # bypass final_publish_gate + cadence (gates remain in code)
# Reconciler (keep after restore): auto-enables ai_pipeline when raw backlog + circuit closed
# Tools: python3 tools/force_single_draft.py [--publish]
#        python3 tools/verify_draft_generation.py
#        python3 tools/end_to_end_pipeline_trace.py
