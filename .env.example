# =============================================================================
# Copy to ".env" and fill values locally. Do not commit real secrets.
# Field guide: README.md, docs/QUICKSTART.md, docs/DEPLOYMENT_QUICKSTART.md
# Production-lite host template: deploy/example.env.production-lite
# =============================================================================

# --- OpenAI (required; placeholder only — set your key locally) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JSON_MAX_RETRIES=3
OPENAI_REQUEST_TIMEOUT_SEC=90
OPENAI_HTTP_TIMEOUT_SEC=120
OPENAI_HTTP_MAX_RETRIES=2
MAX_POST_CHARS=3500
MAX_CLUSTER_POSTS=40
RAW_FETCH_CAP=300
PRECLUSTER_BUCKET_HOURS=6

# Editorial / summarization style (see README «Редакционная настройка»)
SUMMARY_STYLE=neutral
# concise | analytical | neutral | breaking-news | digest-style
EDITORIAL_SAFETY=true
SOURCE_MENTIONS_IN_POST=false
HEADLINE_MODE=none
# none | json (отдельное поле headline в JSON) | prefix (первая строка post)
DIGEST_MULTI_POST=false
DIGEST_COHESION_TRIGGER_BELOW=0.11
QUALITY_SCORING_ENABLED=true

# Pre-cluster lexical gates (Jaccard по словам ≥4 символов; без эмбеддингов)
CLUSTER_MIN_LEXICAL_JACCARD=0.08
CLUSTER_MIN_PAIR_LAST_JACCARD=0.04
PRECLUSTER_TRIM_BUCKET_MULTIPLIER=3

# --- Telegram: Telethon collector (placeholders) ---
# For Docker, prefer session file on a volume (survives restarts):
# TELETHON_SESSION_PATH=/data/telethon.session
# Либо только StringSession:
TELETHON_SESSION_STRING=
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELETHON_OP_MAX_ATTEMPTS=4
CHANNEL_COLLECT_DELAY_SECONDS=1.25

# --- Telegram: aiogram bot (from @BotFather) ---
BOT_TOKEN=
ADMIN_USER_ID=123456789
TARGET_CHANNEL_ID=-1001234567890

# Comma-separated: @channel, -100..., or t.me links username part
SOURCE_CHANNELS=@channel1,@channel2,@channel3

# --- Database (single writer; in container use /data/newsroom.db) ---
DATABASE_URL=sqlite+aiosqlite:///./newsroom.db

# --- Runtime paths (live JSON state; backups) ---
RUNTIME_STATE_DIR=var/runtime
NEWSROOM_BACKUP_DIR=var/backups
# Nightly ops artifacts (Makefile OUTPUT_DIR / CLI --path; not read by app.main):
#   make runtime-nightly RUNTIME_DIR=./var/runtime OUTPUT_DIR=./runtime_ops_output

# --- Pipeline scheduling ---
PIPELINE_INTERVAL_MINUTES=30
COLLECT_MESSAGES_PER_CHANNEL=40
MIN_RAW_POSTS_FOR_AI=3
DRAFT_SIMILARITY_THRESHOLD=0.93
DRAFT_DEDUPE_WINDOW_HOURS=72

# Testing: drafts go to admin, Publish does not post to channel
DRY_RUN=false
# First-boot caution banner (see docs/SELF_HOSTING.md); combine with DRY_RUN for paper mode
# NEWSROOM_SAFE_MODE=false

# --- Logging (INFO for production-lite; DEBUG is very verbose) ---
LOG_LEVEL=INFO
# Truncate long string fields in structured JSON log lines (chars)
LOG_MAX_FIELD_LEN=480

# --- Retention (0 = disabled): DB cleanup on pipeline tick ---
RETENTION_PROCESSED_RAW_DAYS=30
RETENTION_REJECTED_DRAFT_DAYS=60

# Pause between Telegram message chunks (channel publish + long admin notifications)
TELEGRAM_INTER_CHUNK_DELAY_SEC=0.35

# Anomaly / trend (0 disables RSS absolute warn; burst deltas use diagnostics interval)
ANOMALY_PIPELINE_SLOW_ABS_SEC=720
ANOMALY_PIPELINE_SLOW_VS_AVG_MULTIPLIER=2.5
ANOMALY_DUPLICATE_SKIP_STREAK=5
ANOMALY_CLUSTER_SIZE_RATIO=0.92
ANOMALY_ASYNCIO_TASKS_WARN=380
ANOMALY_MEMORY_RSS_BYTES_WARN=0
ANOMALY_TELETHON_RECONNECT_BURST=6
ANOMALY_OPENAI_FAILURES_BURST_DELTA=3
TREND_RING_MAX_SAMPLES=24
TREND_SLOW_MULTIPLIER=2.0
TREND_PUBLISH_SLOW_MULTIPLIER=2.0
MEMORY_TREND_WINDOW=8
WARN_TASK_COUNT_TREND=true
WARN_RSS_TREND=true
WARN_RAW_POSTS_TREND=true
WARN_BACKLOG_TREND=true
QUALITY_MIN_SUMMARY_CHARS=40
QUALITY_LOW_UNIQUENESS_RATIO=0.18
QUALITY_MIN_SOURCES_RATIO=0.25
OPERATIONAL_REPORT_INTERVAL_HOURS=4

# --- Scheduling hints (systemd timer example: deploy/systemd/newsroom-nightly.timer) ---
# OPERATIONAL_REPORT_INTERVAL_HOURS=4
# DIAGNOSTICS_INTERVAL_MINUTES=15
# METRICS_SUMMARY_INTERVAL_MINUTES=30

# --- Optional scaling (PostgreSQL + Redis) ---
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/newsroom
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379/0
# NEWSROOM_QUEUE_PREFIX=newsroom
# WORKER_HEARTBEAT_TTL_SEC=90
# HEALTH_HTTP_PORT=0
# HEALTH_HTTP_BIND=0.0.0.0
# Optional: protect /ops*, /ops.json, /metrics (query ?token= or X-Ops-Token header)
# OPS_HTTP_TOKEN=
# WORKER_VISIBILITY_SEC=120
# WORKER_POLL_INTERVAL_SEC=1.0
# WORKER_MAX_CONCURRENCY=2
# WORKER_GRACE_SHUTDOWN_SEC=30
# WORKER_MAX_JOB_SEC=900
# WORKER_INSTANCE_ID=manual-hostname
