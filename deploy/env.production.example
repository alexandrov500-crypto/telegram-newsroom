# Copy to .env and fill secrets. Do not commit real keys.
APP_DEPLOYMENT_PROFILE=production
DATABASE_URL=sqlite+aiosqlite:////data/newsroom.db
RUNTIME_STATE_DIR=/data/runtime
NEWSROOM_BACKUP_DIR=/data/backups
OPENAI_API_KEY=sk-replace-me
BOT_TOKEN=123456:replace-me
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me_32_chars_minimum_len__
TELETHON_SESSION_STRING=replace_session_string
ADMIN_USER_ID=123456789
TARGET_CHANNEL_ID=-1001234567890
SOURCE_CHANNELS=@channel1,@channel2
DRY_RUN=0
LOG_LEVEL=INFO
PIPELINE_INTERVAL_MINUTES=15
TELEGRAM_INTER_CHUNK_DELAY_SEC=0.55
RETENTION_PROCESSED_RAW_DAYS=30
RETENTION_REJECTED_DRAFT_DAYS=60
DIAGNOSTICS_INTERVAL_MINUTES=15
METRICS_SUMMARY_INTERVAL_MINUTES=30

# Optional: Redis-backed job queue + publish locks (multi-process)
# REDIS_ENABLED=true
# REDIS_URL=redis://redis:6379/0
# For multi-instance production prefer PostgreSQL instead of SQLite:
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/newsroom
