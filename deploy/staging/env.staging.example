# Staging environment — copy to project root as .env
TELEGRAM_BOT_TOKEN=
TELEGRAM_DIGEST_CHANNEL_ID=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_LIVE_INGEST_ENABLED=true
TELEGRAM_LIVE_INGEST_CHAT_ID=
TELEGRAM_LIVE_COGNITIVE_ENABLED=true
TELEGRAM_LIVE_BURNIN_HOURLY=true
TELEGRAM_LIVE_APPROVAL_CARDS=true
TELEGRAM_OPS_AGG_WINDOW_SEC=120
TELEGRAM_OPS_DIGEST_INTERVAL_SEC=1800
TELEGRAM_OPS_MAX_MSG_PER_HOUR=45
TELEGRAM_OPS_FATIGUE_THRESHOLD=0.72
# TELEGRAM_OPS_QUIET_HOUR_START=0
# TELEGRAM_OPS_QUIET_HOUR_END=6
TELEGRAM_CHANNEL_ID=
ADMIN_USER_IDS=123456789

# Block production channels (comma-separated -100… ids)
PRODUCTION_CHANNEL_BLOCKLIST=

APP_ENV=staging
STAGING_MODE=true
SHADOW_PUBLISH_ONLY=true
STAGING_STRICT_STARTUP=true
AUTO_APPROVAL_ENABLED=false

CLUSTER_ENABLED=true
EVENT_BUS_BACKEND=redis
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://newsroom:newsroom@postgres:5432/newsroom

HEALTH_HTTP_PORT=8080
WATCHDOG_ENABLED=true
METRICS_ENABLED=true
OPS_BURNIN_ENABLED=true
OPS_BURNIN_PROFILE=24h
STAGING_FEEDS_PATH=config/feeds.staging.yaml
STAGING_HEALTH_URL=http://127.0.0.1:8080/health

# Tracing → Tempo
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Optional Telethon source channels (comma-separated) — omit keys if unused
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SOURCE_CHANNELS=

OPENAI_API_KEY=
STRUCTURED_LOGGING=true

# Production safety (final hardening)
PRODUCTION_SAFETY_ENABLED=true
PRODUCTION_ROLLOUT_STAGE=INTERNAL_SHADOW
PRODUCTION_DAILY_BUDGET_USD=50
PRODUCTION_HOURLY_BUDGET_USD=8
PRODUCTION_AUTO_ROLLBACK_FATAL=true
# PRODUCTION_CHANNEL_WHITELIST=-100...

# Production reliability layer
RELIABILITY_LAYER_ENABLED=true
RELIABILITY_BURNIN_MODE=false
RELIABILITY_PUBLISH_MODE=SHADOW
RELIABILITY_PROBE_INTERVAL_SEC=30
PUBLISH_STABILITY_SEC=3600
PUBLISH_MAX_QUEUE_DEPTH=400
LIMITED_PRODUCTION_CAP_PER_HOUR=12

# Live operations & scale readiness
LIVE_OPS_ENABLED=true
LIVE_OPS_EVENT_BUS=true
LIVE_OPS_WORKER_MESH=true
LIVE_OPS_RECOVERY_STARTUP=true
STREAM_BACKEND=redis_streams
# RECOVERY_MODE=false
# DEGRADED_STARTUP=false
# NEWSROOM_USE_POSTGRES=false
# NEWSROOM_DUAL_WRITE=false

# Ops certification & chaos hardening
OPS_CERT_ENABLED=true
OPS_CHAOS_ENABLED=false
OPS_CHAOS_SCHEDULED=false
OPS_SLO_ENABLED=true
OPS_CERT_WINDOW_HOURS=24
OPS_CERT_MIN_SCORE=0.85
# OPS_AUDIT_HMAC_SECRET=change-me-in-production

# RC1 stabilization & activation
RC1_ENABLED=true
RC1_LOCKDOWN_MODE=false
RC1_PROFILING=true
RC1_BASELINES=true
RC1_ACTIVATION=true

# GA operations (pre-general availability)
GA_OPS_ENABLED=true
GA_TRAFFIC_GUARDRAILS=true
GA_QUALITY_VALIDATION=true
GA_MAX_PUBLISHES_PER_HOUR=40
GA_READINESS_MIN_SCORE=0.88

# Post-GA live operations tuning (enable in production after GA)
# POST_GA_ENABLED=true

# Autonomous operations evolution (long-term)
OPS_EVOLUTION_ENABLED=true

# Platformization & internal ecosystem (plugins, workflows, policy, graph)
# PLATFORM_ENABLED=true
