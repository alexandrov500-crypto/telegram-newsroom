# Optional: start Timeweb compose on boot (adjust paths).
# sudo cp deploy/systemd/newsroom-docker.service /etc/systemd/system/
# sudo systemctl enable newsroom-docker

[Unit]
Description=Telegram Newsroom Docker Compose
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/newsroom/app/deploy/timeweb
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
