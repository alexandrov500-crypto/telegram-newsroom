# Controlled Public Pilot — copy to .env.production and fill channel IDs
#   cp deploy/production/env.pilot.example .env.production
#
# Then: bash scripts/pilot_preflight.py --env-file .env.production
#       bash scripts/pilot_activate.sh

APP_ENV=production
STAGING_MODE=false
SHADOW_PUBLISH_ONLY=false

# --- Telegram channels (REQUIRED: fill real IDs) ---
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
ADMIN_USER_IDS=
TELEGRAM_OPERATOR_CHAT_ID=

# Public test channel — real audience, limited promotion
LIVE_PUBLIC_CHANNEL_ID=-100XXXXXXXXXX
TELEGRAM_CHANNEL_ID=-100XXXXXXXXXX

# Internal ops — all holds, freeze, rollback, anomaly alerts
LIVE_OPS_CHANNEL_ID=-100XXXXXXXXXX

# Optional shadow comparison channel
LIVE_SHADOW_CHANNEL_ID=-100XXXXXXXXXX
TELEGRAM_DIGEST_CHANNEL_ID=-100XXXXXXXXXX

# --- Controlled public pilot (STRICT: first 48h) ---
CONTROLLED_LIVE_ENABLED=true
LIVE_MODE=canary
LIVE_CANARY_MAX_PER_HOUR=3
LIVE_SUPERVISED_APPROVAL=true
LIVE_CANARY_APPROVAL=true
LIVE_FREEZE_ON_ANOMALY=true
LIVE_ENABLE_ROLLBACK=true
LIVE_ALLOWED_SOURCES=reuters,ap,bloomberg
LIVE_SOURCE_BAD_THRESHOLD=3
LIVE_SOURCE_COOLDOWN_HOURS=6
LIVE_METRICS_INTERVAL_SEC=300

# Safety layers (keep enabled during pilot)
LIVE_DEPLOY_ENABLED=true
WEEK1_STABILIZATION_ENABLED=true
OPERATIONAL_MEMORY_ENABLED=true
PRODUCTION_STRICT_STARTUP=true
AUTO_APPROVAL_ENABLED=false

# Rollout — limited public, not full autonomous
PRODUCTION_ROLLOUT_STAGE=LOW_FREQUENCY_PUBLIC
RELIABILITY_PUBLISH_MODE=LIMITED

OPENAI_API_KEY=
DATABASE_URL=sqlite+aiosqlite:////data/newsroom.db
REDIS_URL=redis://redis:6379/0
HEALTH_HTTP_PORT=8080
