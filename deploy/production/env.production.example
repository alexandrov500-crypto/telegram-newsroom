# =============================================================================
# PRODUCTION — Operator node (command surface + publish)
# Copy: cp deploy/production/env.production.example .env.production
# =============================================================================

APP_ENV=production
STAGING_MODE=false
NODE_ID=operator-1
NODE_ROLE=operator
CLUSTER_ENABLED=true

# --- Telegram (single bot: operator chat + channel publish) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_DIGEST_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_OPERATOR_CHAT_ID=
ADMIN_USER_IDS=
GO_LIVE_EMERGENCY_CONTACTS=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SOURCE_CHANNELS=

# --- Go-live / strict startup ---
GO_LIVE_ENABLED=true
GO_LIVE_STRICT_STARTUP=true
PRODUCTION_STRICT_STARTUP=true
GO_LIVE_STRICT_PERMISSIONS=true
GO_LIVE_PUBLISH_PROBE=true
GO_LIVE_STARTUP_PING=true
GO_LIVE_EXECUTIVE_DASHBOARD=true
SHADOW_PUBLISH_ONLY=true
AUTO_APPROVAL_ENABLED=false

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Postgres ---
POSTGRES_USER=newsroom
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=newsroom
DATABASE_URL=postgresql+asyncpg://newsroom:change-me-strong@postgres:5432/newsroom

# --- Redis / event bus ---
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
EVENT_BUS_BACKEND=redis
STREAM_BACKEND=redis_streams

# --- Reliability ---
RELIABILITY_ENABLED=true
RELIABILITY_PUBLISH_MODE=SHADOW
RELIABILITY_AUTO_ROLLBACK=true

# --- Production safety / rollout ---
PRODUCTION_SAFETY_ENABLED=true
PRODUCTION_ROLLOUT_STAGE=INTERNAL_SHADOW
PRODUCTION_CHANNEL_WHITELIST=
PRODUCTION_CHANNEL_BLOCKLIST=
PRODUCTION_AUTO_ROLLBACK_FATAL=true

# --- GA ops ---
GA_OPS_ENABLED=true
GA_QUALITY_VALIDATION=true
GA_MAX_PUBLISHES_PER_HOUR=40
GA_READINESS_MIN_SCORE=0.88

# --- RC1 ---
RC1_ENABLED=true
RC1_LOCKDOWN_MODE=true

# --- Live ops / workers ---
LIVE_OPS_ENABLED=true
LIVE_OPS_WORKER_MESH=true
LIVE_OPS_RECOVERY_STARTUP=true
OPS_CERT_ENABLED=true
POST_GA_ENABLED=true
OPS_EVOLUTION_ENABLED=true
PLATFORM_ENABLED=true
OPS_PLAYBOOK_ENABLED=true
OPS_LAUNCH_PERIOD_DAYS=30
OPS_PRODUCTION_START_AT=

# Live public deployment execution
LIVE_DEPLOY_ENABLED=true
FIRST_72H_MODE=true
FIRST_72H_HOURS=72
LIVE_MIN_QUALITY=0.78
LIVE_MIN_TRUST=0.82
LIVE_MIN_CONFIDENCE=0.88
LIVE_MANDATORY_APPROVAL=true

# First-week production stabilization
WEEK1_STABILIZATION_ENABLED=true
WEEK1_ALERT_DEDUPE_SEC=900
WEEK1_ACTIONABLE_ONLY=true
WEEK1_BASELINE_CAPTURE=true

# Operational memory + predictive stability
OPERATIONAL_MEMORY_ENABLED=true
OPMEM_RETENTION_DAYS=90
OPMEM_PREDICTION=true
OPMEM_DRIFT=true
OPMEM_SEASONALITY=true
OPMEM_AUTO_INCIDENTS=true
OPMEM_QUEUE_SPIKE=150
OPMEM_RETRY_STORM=0.15

# Controlled public pilot (first 48h: canary only)
CONTROLLED_LIVE_ENABLED=true
LIVE_MODE=canary
LIVE_CANARY_MAX_PER_HOUR=3
LIVE_SUPERVISED_APPROVAL=true
LIVE_CANARY_APPROVAL=true
LIVE_FREEZE_ON_ANOMALY=true
LIVE_ENABLE_ROLLBACK=true
LIVE_ALLOWED_SOURCES=reuters,ap,bloomberg
LIVE_PUBLIC_CHANNEL_ID=
LIVE_OPS_CHANNEL_ID=
LIVE_SHADOW_CHANNEL_ID=
LIVE_SOURCE_BAD_THRESHOLD=3
LIVE_SOURCE_COOLDOWN_HOURS=6
LIVE_METRICS_INTERVAL_SEC=300
LIVE_SAFE_HOURS_START=6
LIVE_SAFE_HOURS_END=22
LIVE_SAFE_HOURS_ONLY=false

# --- Observability ---
HEALTH_HTTP_PORT=8080
HEALTH_HTTP_BIND=0.0.0.0
METRICS_ENABLED=true
STRUCTURED_LOGGING=true
LOG_JSON_FILE=/var/log/newsroom/newsroom.jsonl
WATCHDOG_ENABLED=true

# --- Governance ---
PRODUCTION_GOVERNANCE_FREEZE=false

# --- RSS ---
RSS_FEEDS=https://feeds.reuters.com/reuters/worldNews
