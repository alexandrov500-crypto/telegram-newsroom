# =============================================================================
# Production-lite single-node environment (copy to .env on the host).
# Do not commit real secrets. See docs/DEPLOYMENT_QUICKSTART.md
# =============================================================================

# --- Deployment profile ---
APP_DEPLOYMENT_PROFILE=production-lite
NEWSROOM_PROFILE=production-lite

# --- Startup / HTTP timeouts (seconds) ---
HEALTHCHECK_TIMEOUT_SEC=60
TELEGRAM_HTTP_TIMEOUT_SEC=60
TELEGRAM_POLLING_ENABLED=true
SEND_STARTUP_NOTIFICATION=true
SEND_RECOVERY_NOTIFICATION=false
NOTIFICATION_RATE_LIMIT_MINUTES=30

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JSON_MAX_RETRIES=3
OPENAI_REQUEST_TIMEOUT_SEC=90
OPENAI_HTTP_TIMEOUT_SEC=120

# --- Telegram: Telethon collector ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_32_char_api_hash_placeholder
TELETHON_SESSION_STRING=replace_with_exported_string_session
# Or persist session on volume: TELETHON_SESSION_PATH=/data/telethon.session

# --- Telegram: aiogram bot ---
BOT_TOKEN=123456789:replace-with-botfather-token
ADMIN_USER_ID=123456789
TARGET_CHANNEL_ID=-1001234567890
SOURCE_CHANNELS=@channel1,@channel2

# --- Database (single writer; SQLite on persistent volume) ---
DATABASE_URL=sqlite+aiosqlite:////data/newsroom.db

# --- Runtime paths (live process JSON state) ---
RUNTIME_STATE_DIR=/data/runtime
NEWSROOM_BACKUP_DIR=/data/backups

# Nightly ops output (Makefile OUTPUT_DIR / CLI --path); not read by app.main
# Default when running make targets: ./runtime_ops_output

# --- Pipeline scheduling ---
PIPELINE_INTERVAL_MINUTES=30
COLLECT_MESSAGES_PER_CHANNEL=40
MIN_RAW_POSTS_FOR_AI=3
# First boot: DRY_RUN=true until controlled_activation runbook P2
DRY_RUN=false

# T1 bounded publish (config-enforceable burst cap within 3600s window)
# PUBLISH_CHANNEL_MIN_INTERVAL_SEC=300
# PUBLISH_BURST_WINDOW_SEC=3600
# PUBLISH_BURST_MAX_MESSAGES=5

# --- Logging ---
LOG_LEVEL=INFO
LOG_MAX_FIELD_LEN=480

# --- Retention (0 = disabled) ---
RETENTION_PROCESSED_RAW_DAYS=30
RETENTION_REJECTED_DRAFT_DAYS=60

# --- Telegram pacing ---
TELEGRAM_INTER_CHUNK_DELAY_SEC=0.55
TELEGRAM_STARTUP_NOTIFY=true

# --- Optional: Redis (disabled for minimal production-lite) ---
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Optional: ops HTTP (0 = disabled) ---
HEALTH_HTTP_PORT=0
