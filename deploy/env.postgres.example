# Example environment for deploy/docker-compose.postgres.yml (copy and fill secrets).
APP_DEPLOYMENT_PROFILE=production
DATABASE_URL=postgresql+asyncpg://newsroom:newsroom@postgres:5432/newsroom
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
NEWSROOM_QUEUE_PREFIX=newsroom
WORKER_HEARTBEAT_TTL_SEC=90
HEALTH_HTTP_PORT=8080
HEALTH_HTTP_BIND=0.0.0.0
RUNTIME_STATE_DIR=/data/runtime
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4.1-mini
BOT_TOKEN=123456:replace-me
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me_32_chars_minimum_len__
TELETHON_SESSION_STRING=replace_session_string
ADMIN_USER_ID=123456789
TARGET_CHANNEL_ID=-1001234567890
SOURCE_CHANNELS=@channel1,@channel2
DRY_RUN=0
LOG_LEVEL=INFO
PIPELINE_INTERVAL_MINUTES=15

# Worker tuning (optional; defaults in app/config.py)
# WORKER_VISIBILITY_SEC=120
# WORKER_POLL_INTERVAL_SEC=1.0
# WORKER_MAX_CONCURRENCY=2
# WORKER_GRACE_SHUTDOWN_SEC=30
# WORKER_MAX_JOB_SEC=900
# WORKER_INSTANCE_ID=publisher-1
