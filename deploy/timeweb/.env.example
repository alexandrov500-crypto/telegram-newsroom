# Timeweb VPS production — copy to .env and fill secrets (never commit .env).

# --- Identity (requested + app profiles) ---
ENV=production
APP_ENV=production
# Must allow scheduler ticks (overrides stale operational_mode.json on volume)
RUNTIME_OPERATIONAL_MODE=production
SUMMARY_STYLE=cb-economics-brief
HEADLINE_MODE=json
NEWSROOM_CB_BRIEF_FORMAT=true
SOURCE_MENTIONS_IN_POST=false
PUBLISH_INCLUDE_SOURCES=false
LOG_LEVEL=INFO
APP_DEPLOYMENT_PROFILE=production-lite
NEWSROOM_PROFILE=production-lite
NEWSROOM_MIN_SIGNAL_SCORE=0.55
# aggressive = max audience reach (RU hooks, CTA, hashtags, faster cadence)
NEWSROOM_GROWTH_MODE=aggressive
GROWTH_CADENCE_DAILY_CAP=35
GROWTH_PHASE=d7

# --- W1 growth subsystem ---
TELEGRAM_ANALYTICS_ENABLED=true
TELEGRAM_ANALYTICS_INTERVAL_MIN=15
TELEGRAM_ANALYTICS_RETENTION_DAYS=90
TELEGRAM_ANALYTICS_POLL_BATCH=40
BREAKING_LANE_ENABLED=true
BREAKING_LANE_INTERVAL_MIN=3
BREAKING_COOLDOWN_SEC=600
BREAKING_T0_SOURCES=
SOURCE_REGISTRY_EXPAND=false
COLLECT_PARALLEL_ENABLED=true
COLLECT_SHARD_SIZE=3
COLLECT_MAX_INFLIGHT_SHARDS=2
FLOOR_MIN_ELIGIBILITY_SCORE=0.72
HEADLINE_ENGINE_ENABLED=true

# --- W2 adaptive growth engine ---
GROWTH_CADENCE_ENGINE_ENABLED=true
GROWTH_FEEDBACK_ENABLED=true
GROWTH_SOURCE_YIELD_ENABLED=true
GROWTH_DIGEST_ENABLED=true
GROWTH_DIGEST_CHECK_INTERVAL_MIN=60
GROWTH_TIMING_OPTIMIZER_ENABLED=true
GROWTH_FATIGUE_DECAY_HOURS=18
GROWTH_TOPIC_SATURATION_LIMIT=0.72
BREAKING_COLLAPSE_WINDOW_SEC=7200
GROWTH_ENGAGEMENT_PRIOR_MEAN=0.35
GROWTH_ENGAGEMENT_PRIOR_STRENGTH=8

# --- W3 editorial identity + distribution flywheel ---
# Reference model @cb_economics: macro RU economics, no synthetic opinion prefixes.
NEWSROOM_REFERENCE_MODEL=cb_economics
W3_EDITORIAL_PIPELINE_ENABLED=true
EDITORIAL_IDENTITY_ENABLED=true
EDITORIAL_OPINION_LAYER_ENABLED=false
EDITORIAL_IDENTITY_MIN_STYLE=0.58
EDITORIAL_IDENTITY_MIN_INSIGHT=0.45
GROWTH_EXPLORE_BUDGET_DAILY=3
RETENTION_HABIT_ENABLED=true
W3_FLYWHEEL_MAINTENANCE_ENABLED=true
W3_FLYWHEEL_MAINTENANCE_INTERVAL_HOURS=6
# Optional multi-channel surfaces (defaults to TARGET_CHANNEL_ID if unset)
# TELEGRAM_DIGEST_CHANNEL_ID=-1009876543210
# TELEGRAM_BREAKING_CHANNEL_ID=-1009876543211

# --- W5 monetization + B2B productization ---
W5_MONETIZATION_ENABLED=true
W5_REVENUE_ENGINE_ENABLED=true
W5_SPONSOR_INJECTION_ENABLED=true
W5_PREMIUM_LAYER_ENABLED=true
W5_B2B_API_ENABLED=true
W5_RSS_FEED_ENABLED=true
W5_CONVERSION_FUNNEL_ENABLED=true
W5_AD_INVENTORY_ENABLED=true
W5_MONETIZATION_BALANCE_ENABLED=true
W5_MONETIZATION_MAINTENANCE_ENABLED=true
W5_MONETIZATION_MAINTENANCE_INTERVAL_HOURS=12
W5_SPONSOR_MAX_DAILY=2
W5_MAX_SPONSOR_RATIO_24H=0.18
W5_SPONSOR_MIN_SAFETY=0.62
W5_SPONSOR_DEFAULT_CPM_USD=12
W5_PREMIUM_MIN_INSIGHT=0.72
W5_B2B_API_RATE_LIMIT_HOUR=120
# W5_B2B_API_KEY=replace-with-long-random-key
# W5_PREMIUM_CHANNEL_ID=-1009876543212
# W5_PREMIUM_CHANNEL_LINK=https://t.me/your_premium_channel
# W5_SPONSOR_DEFAULT_LINK=https://example.com/partner
# W5_SPONSOR_DEFAULT_LABEL=Market intelligence tools

# --- Secrets (required) ---
OPENAI_API_KEY=sk-replace-me
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_32_char_api_hash
BOT_TOKEN=123456789:replace-with-botfather-token

# Telethon: string session OR file on persistent volume (prefer path on VPS)
# TELETHON_SESSION_STRING=
TELETHON_SESSION_PATH=/data/sessions/telethon.session
# Route the collector's MTProto connection over IPv6. Enable only if this host's
# IPv4 path to Telegram DCs is blocked but IPv6 works (also requires container
# IPv6 egress, e.g. an enable_ipv6 docker network with NAT). Default: false (IPv4).
# TELETHON_USE_IPV6=false
#
# Route the collector through a TRUSTED proxy when this host cannot reach Telegram
# DCs directly (your user session flows through it — never use an untrusted proxy).
#   TELETHON_PROXY=socks5://user:pass@host:1080
#   TELETHON_PROXY=http://host:8080
#   TELETHON_PROXY=mtproxy://host:443?secret=ee1234...   # MTProto proxy secret (hex/ee-prefixed)
# TELETHON_PROXY=

# --- Startup / HTTP timeouts (seconds) ---
HEALTHCHECK_TIMEOUT_SEC=60
# Fewer retries = faster boot on slow VPS↔Telegram links (0 = one attempt)
TELEGRAM_STARTUP_HEALTH_MAX_RETRIES=1
TELEGRAM_HTTP_TIMEOUT_SEC=60
TELEGRAM_POLLING_ENABLED=true
# worker = full pipeline + polling on this host; control = Mac management (no polling)
RUNTIME_NODE_ROLE=worker
# One host only. false = no «Newsroom started» spam (recommended if Mac + VPS share BOT_TOKEN).
SEND_STARTUP_NOTIFICATION=false
SEND_RECOVERY_NOTIFICATION=false
NOTIFICATION_RATE_LIMIT_MINUTES=30
RUNTIME_DEGRADED_AFTER_N_FAILURES=3
RUNTIME_UNAVAILABLE_AFTER_N_MINUTES=30
RUNTIME_RECOVERY_STABILITY_WINDOW_SEC=120
OPENAI_REQUEST_TIMEOUT_SEC=90
OPENAI_HTTP_TIMEOUT_SEC=120

# --- OpenAI ---
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JSON_MAX_RETRIES=3
# Optional relay/proxy endpoint. If this VPS region is geo-blocked by OpenAI,
# point this at an OpenAI-compatible relay in an allowed region to restore live
# AI summarization. Leave empty to use the official api.openai.com endpoint.
# OPENAI_BASE_URL=https://your-relay.example.com/v1
#
# YandexGPT alternative (OpenAI-compatible relay, e.g. YandexGPT_to_OpenAI sidecar):
#   OPENAI_BASE_URL=http://y2o:8520/v1
#   OPENAI_MODEL=gpt-4.1            # relay aliases gpt-4* -> yandexgpt/latest (no slash: startup validation rejects "yandexgpt/latest")
#   OPENAI_API_KEY=sk-y2o-...       # token issued by the relay, not your Yandex key

# --- Telegram ops ---
ADMIN_USER_ID=123456789
# Comma-separated extra operators (optional)
ADMIN_USER_IDS=
# If set, draft approval keyboards go to this group/supergroup (must include bot; admins use buttons)
MODERATION_CHAT_ID=
TARGET_CHANNEL_ID=-1001234567890
# Macro RU economics — same lane as @cb_economics (no crypto teasers / premium funnels).
SOURCE_CHANNELS=@cb_economics,@rbc_news,@vedomosti,@banksta
# Optional peers: @thebell_io
SOURCE_CHANNEL_LANGUAGES=@cb_economics:ru,@rbc_news:ru,@vedomosti:ru,@banksta:ru
PUBLISH_OUTPUT_LANGUAGE=ru
NEWSROOM_PRIMARY_NICHES=macro,business,finance
NEWSROOM_EXCLUDE_GENERAL_FEED=true

# --- Host bind-mount roots (VPS layout under /opt/newsroom) ---
NEWSROOM_HOST_DATA=/opt/newsroom/data
NEWSROOM_HOST_LOGS=/opt/newsroom/logs
NEWSROOM_HOST_SESSIONS=/opt/newsroom/sessions
# Host .env file mounted for gen_session.py --write-env (default: ./.env in deploy/timeweb)
# NEWSROOM_ENV_FILE=/opt/newsroom/deploy/timeweb/.env

# --- Database & paths (inside container) ---
DATABASE_URL=sqlite+aiosqlite:////data/newsroom.db
RUNTIME_STATE_DIR=/data/runtime
NEWSROOM_BACKUP_DIR=/data/backups

# --- Pipeline (top news wire: 5 min tick, 1 min breaking lane) ---
NEWSROOM_CHANNEL_BEAT=top_news
NEWSROOM_REFERENCE_MODEL=cb_economics
NEWSROOM_GROWTH_MODE=aggressive
PIPELINE_INTERVAL_MINUTES=5
BREAKING_LANE_INTERVAL_MIN=1
COLLECT_MESSAGES_PER_CHANNEL=50
COLLECT_PARALLEL_ENABLED=true
FAST_LANE_ENABLED=true
MIN_RAW_POSTS_FOR_AI=1
DRY_RUN=false

# --- Logging ---
LOG_MAX_FIELD_LEN=480

# --- Health HTTP (container healthcheck + optional host curl) ---
HEALTH_HTTP_PORT=8080
HEALTH_HTTP_BIND=0.0.0.0
# Bind health port on localhost only (recommended on VPS)
HEALTH_HTTP_PUBLISH_PORT=127.0.0.1:8080

# --- Timezone ---
TZ=Europe/Moscow

# --- Retention ---
RETENTION_PROCESSED_RAW_DAYS=30
RETENTION_REJECTED_DRAFT_DAYS=60

# --- Telegram pacing ---
TELEGRAM_INTER_CHUNK_DELAY_SEC=0.55
TELEGRAM_STARTUP_NOTIFY=true
PUBLISH_CHANNEL_MIN_INTERVAL_SEC=45
PUBLISH_BURST_MAX_MESSAGES=8
PUBLISH_BURST_WINDOW_SEC=600
NEWS_BEAT_TOPIC_COOLDOWN_SEC=600
SOURCE_COOLDOWN_MINUTES=4
EDITORIAL_TARGET_POSTS_PER_DAY=28
GROWTH_CADENCE_DAILY_CAP=42
GROWTH_TIMING_OPTIMIZER_ENABLED=false

# --- Redis (off for production-lite) ---
REDIS_ENABLED=false

# =====================================================================
# RELIABILITY FLOOR — keep the channel publishing no matter what.
# Do NOT disable these when experimenting with ranking/marketing.
# These guarantee the channel never goes silent for a long period even
# if editorial/marketing algorithm changes would reject every draft.
# =====================================================================
AUTO_PUBLISH_ENABLED=true
AUTONOMOUS_EDITORIAL_MODE=true
AI_EDITORIAL_REVIEW_ENABLED=true
AI_EDITORIAL_MIN_CONFIDENCE=0.68
# AUTONOMOUS_EDITORIAL_MODE=true → AI reviews drafts, no moderation Telegram messages
LIVE_SUPERVISED_APPROVAL=false
# Guaranteed publishing floor: after this many minutes of silence, force one
# trustworthy post in safety-only mode (advertising/governance/trust still apply).
PUBLISH_FLOOR_ENABLED=true
PUBLISH_FLOOR_MAX_SILENCE_MIN=22
# Backlog relief (softer, earlier recovery before the hard floor).
AUTO_PUBLISH_BACKLOG_RELIEF_ENABLED=true
AUTO_PUBLISH_MAX_SCHEDULE_PER_TICK=6
AUTO_PUBLISH_PENDING_SCAN_LIMIT=24
AUTO_PUBLISH_STALE_PENDING_HOURS=72
# Trusted macro sources — cb_economics-style fast lane (desk → auto-publish).
AUTO_PUBLISH_FASTLANE_SOURCES=@cb_economics,@rbc_news,@vedomosti,@banksta
AUTO_PUBLISH_ALLOWED_CATEGORIES=macro,market,breaking,analysis
# Keep generating drafts via the rule-based summarizer when OpenAI is down,
# so the channel never runs dry on fresh content during a provider outage.
SUMMARIZE_RULE_FALLBACK_WHEN_AI_DOWN=true

# =====================================================================
# MARKETING / GROWTH — cosmetic, tune freely on later stages.
# Changing these can NEVER stall publishing (reliability floor above).
# Off by default: re-enable only when copy is localized and relevant.
# =====================================================================
# Aggressive growth enables hooks/loops/CTA automatically via growth_profile.py
GROWTH_SIGNATURE_ENABLED=false
NEWSROOM_ENGAGEMENT_HOOK_ENABLED=false
NEWSROOM_OPEN_LOOP_ENABLED=false
NEWSROOM_BRAND_FOOTER_ENABLED=false
NEWSROOM_SHARE_NUDGE_ENABLED=false
NEWSROOM_HASHTAGS_ENABLED=true
NEWSROOM_HASHTAGS_MAX=3
PUBLISH_CHANNEL_MIN_INTERVAL_SEC=75
NEWSROOM_HASHTAGS_MAX=3

# =====================================================================
# MEDIA — attach only real source photos; no synthetic placeholder cards.
# =====================================================================
MEDIA_PIPELINE_ENABLED=true
MEDIA_BRANDED_FALLBACK_ENABLED=false
# PUBLISH_FALLBACK_MEDIA=false  # default: follow MEDIA_BRANDED_FALLBACK_ENABLED
# MEDIA_AI_IMAGE_ENABLED=false  # optional DALL·E when source has no photo
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
