# Copy to deploy/env/vps.env (or deploy/timeweb/.env) on VPS — never commit secrets.
# See deploy/timeweb/.env.example for full variable list.

APP_DEPLOYMENT_PROFILE=production-lite
RUNTIME_OPERATIONAL_MODE=production
DRY_RUN=false
PIPELINE_INTERVAL_MINUTES=15
PIPELINE_BOOTSTRAP_ON_START=false

DATABASE_URL=sqlite+aiosqlite:////data/newsroom.db
RUNTIME_STATE_DIR=/data/runtime
HEALTH_HTTP_PORT=8080
HEALTH_HTTP_BIND=0.0.0.0

BURNIN_SOFT_GOVERNANCE=true
BURNIN_OPENAI_ALWAYS_FALLBACK=true
MEDIA_PIPELINE_ENABLED=true
BACKUP_ON_STARTUP=true
MAX_TICK_RUNTIME_SEC=1200

# Autonomous publish — enable only after burn-in policy review
AUTO_PUBLISH_ENABLED=false
LOCAL_RUNTIME_ALLOWED=false
